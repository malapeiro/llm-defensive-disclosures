# HYDROBOX reference Suricata signatures — municipal water station web HMIs.
# Verification level: Execution-verified against Suricata 8.0.8 (offline pcap
# replay of the synthetic loopback lab; see verification/README.md).
# rev 2 (2026-11-11), sids 2026110701/2026110702: "endswith" on http.uri replaced
# by a pcre on http.uri.raw that also accepts one trailing byte that Python's
# http.server drops as whitespace (0x09, 0x0b, 0x0c, 0x1c-0x1f, 0x85, 0xa0).
# rev 1 could be evaded with e.g. /setpoint\xa0.
# rev 3 of sids 2026110701/2026110702 and rev 2 of 2026110703-2026110705
# (2026-11-11): the patterns follow how Python's http.server tokenises the
# request line (any run of 0x09-0x0d, 0x1c-0x20, 0x85, 0xa0 is a separator) and
# how canonicalize_request treats a path without its leading slash. sid
# 2026110706 is new: when such a byte replaces the space after the method,
# Suricata puts the path in the method token.
# rev 4 of sids 2026110701/2026110702 (2026-11-11): a version token glued to the
# path is accepted whatever its value. rev 2 of 2026110706: matches any "/" in
# the method token, because canonicalize_request also routes a path without its
# leading slash (POST<0xa0>api/valve/out), which the "/api/" match missed.
#
# Address groups (define in suricata.yaml):
#   MAINT_NET          — authorized OT maintenance / SCADA bastion network(s)
#   WATER_CONTROLLERS  — municipal water station HMI / PLC web interfaces
#
# Direction !$MAINT_NET -> $WATER_CONTROLLERS alerts on actuation/configuration
# POST requests originating outside the declared maintenance network.
# NOTE: http.method and http.uri require plaintext HTTP or TLS termination at
# the sensor (see detections/README.md).

alert http !$MAINT_NET any -> $WATER_CONTROLLERS any (msg:"OT-WATER Remote pump or chlorine dosing setpoint write to water HMI"; flow:established,to_server; http.method; content:"POST"; http.uri.raw; content:"/setpoint"; pcre:"/\/setpoint(?:[\x09-\x0d\x1c-\x20\x85\xa0]+HTTP\/[^\x09-\x0d\x1c-\x20\x85\xa0]*)?[\x09-\x0d\x1c-\x20\x85\xa0]*$/"; classtype:attempted-admin; sid:2026110701; rev:4;)

alert http !$MAINT_NET any -> $WATER_CONTROLLERS any (msg:"OT-WATER Remote filter backwash command to water HMI"; flow:established,to_server; http.method; content:"POST"; http.uri.raw; content:"/backwash"; pcre:"/\/backwash(?:[\x09-\x0d\x1c-\x20\x85\xa0]+HTTP\/[^\x09-\x0d\x1c-\x20\x85\xa0]*)?[\x09-\x0d\x1c-\x20\x85\xa0]*$/"; classtype:attempted-admin; sid:2026110702; rev:4;)

alert http !$MAINT_NET any -> $WATER_CONTROLLERS any (msg:"OT-WATER Remote outlet valve actuation on water HMI"; flow:established,to_server; http.method; content:"POST"; http.uri.raw; content:"api/valve/out"; pcre:"/^[\x09-\x0d\x1c-\x20\x85\xa0]*\/?api\/valve\/out/"; classtype:attempted-admin; sid:2026110703; rev:2;)

alert http !$MAINT_NET any -> $WATER_CONTROLLERS any (msg:"OT-WATER Remote alarm suppression request on water HMI"; flow:established,to_server; http.method; content:"POST"; http.uri.raw; content:"api/alarm/mute"; pcre:"/^[\x09-\x0d\x1c-\x20\x85\xa0]*\/?api\/alarm\/mute/"; classtype:attempted-admin; sid:2026110704; rev:2;)

alert http !$MAINT_NET any -> $WATER_CONTROLLERS any (msg:"OT-WATER Access to hidden daily-code service authentication endpoint"; flow:established,to_server; http.method; content:"POST"; http.uri.raw; content:"api/service_login"; pcre:"/^[\x09-\x0d\x1c-\x20\x85\xa0]*\/?api\/service_login/"; classtype:attempted-admin; sid:2026110705; rev:2;)

alert http !$MAINT_NET any -> $WATER_CONTROLLERS any (msg:"OT-WATER Non-compliant request line to water HMI - path inside method token"; flow:established,to_server; http.method; content:"/"; classtype:protocol-command-decode; sid:2026110706; rev:2;)
