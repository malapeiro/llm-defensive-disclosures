# SUNSTRIKE M3 — sunstrike_m3.rules — Suricata 7.0.3 / 8.0.8
# Lab v0.7.5 (selada 5162964f...) — só loopback 127.0.0.1.
# Portas: guard 8609, gate 8610, dispositivos 8611-8622 (HTTP/1.1, JSON).
# msg = ID da regra do detetor do lab. sid 9100001+.
# Regras request-based vêem o PEDIDO (não a execução); regras response-based
# vêem a RECUSA do lab (409/403/400/429) — aproximações declaradas no
# M3_PREVISOES.md. Estado interno (SoC, kWp, STRESS/EMERGENCY, acumuladores)
# NÃO é visível na rede: regras correspondentes não existem aqui (lacunas
# declaradas). Mapeamento ATT&CK no metadata é PROVISÓRIO (reconfirmado M5).

alert tcp any any -> 127.0.0.0/8 [8609,8610,8611:8622] (msg:"SUNSTRIKE D-AUTH-DEFAULT — login no FLEETGATE com credenciais default"; flow:established,to_server; content:"POST /fleet/login"; content:"sunadmin-2026"; metadata:created_at 2026_11_14, attack_technique T0819, attack_technique T1078, sunstrike_rule D-AUTH-DEFAULT; classtype:attempted-admin; sid:9100001; rev:1;)

