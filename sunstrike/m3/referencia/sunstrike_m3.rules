alert tcp any any -> 127.0.0.0/8 [8609,8610,8611:8622] (msg:"SUNSTRIKE D-FLEET-SHUTDOWN-WAVE — >= k shutdowns remotos sem work-order em janela de 60 s"; flow:established,to_server; pcre:"/(?:POST \/fleet\/device\/\d+\/shutdown|\"action\": \"inverter_power_off\"(?![^}]*\"work_order\"))/"; threshold: type threshold, track by_src, count 6, seconds 60; metadata:created_at 2026_11_14, attack_technique T0816, sunstrike_rule D-FLEET-SHUTDOWN-WAVE; classtype:attempted-dos; sid:9100005; rev:1;)

